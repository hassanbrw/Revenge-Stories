# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- TTS ---
# TTS_ENGINE = kokoro | elevenlabs  (kokoro is free/local and is the default)
TTS_ENGINE=kokoro
ELEVENLABS_API_KEY=
# Kokoro parallelism: TTS_CHUNKS pieces of narration are split up and queued
# across TTS_WORKERS parallel processes (chunks can outnumber workers — the
# pool just works through the queue). On this local machine, RAM is the
# limit (~8.5GB free at idle), so both are kept low. On a bigger pod, raise
# TTS_WORKERS to roughly the pod's real core count and TTS_CHUNKS higher
# still (e.g. 70-80) for finer-grained load balancing — see .env.pod.example.
TTS_WORKERS=2
TTS_CHUNKS=2

# --- Stock footage (Channel A/B backgrounds) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Gemini (story + metadata generation — free tier) ---
# Get a free key at https://aistudio.google.com/apikey
# LLM_PROVIDER = openrouter | gemini  (openrouter is pay-per-token, no daily cap; gemini free tier caps at 20 req/day)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Remotion Lambda (ultra-fast cloud video rendering, paid AWS usage) ---
# RENDER_ENGINE = ffmpeg | local | lambda  (ffmpeg is free/fast - default, local is free/slow, lambda is paid/fast)
# See remotion/README or build log for AWS/IAM setup steps.
RENDER_ENGINE=ffmpeg
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_REGION=us-east-1
REMOTION_LAMBDA_BUCKET=
REMOTION_LAMBDA_SERVE_URL=
