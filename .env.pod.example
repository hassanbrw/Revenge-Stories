# Env file for the pod (RunPod/Vast.ai), passed at container-run time via
# `docker run --env-file .env.pod ...` — never baked into the image. Copy
# this to `.env.pod`, fill in the real API keys (same values as your local
# `.env`), and tune the two TTS numbers below for whatever pod you actually
# rented — they're not automatic, since the container has no way to know
# the pod's real core count on its own.

TTS_ENGINE=kokoro
# TTS_WORKERS: set to roughly the pod's real vCPU count (check with `nproc`
# on the pod once it's running). TTS_CHUNKS: split narration into more,
# smaller pieces than there are workers (e.g. 70-80) so no single worker
# ends up stuck on one disproportionately long chunk while the rest sit
# idle — the pool just queues the extras.
TTS_WORKERS=16
TTS_CHUNKS=76
KOKORO_WORKER_THREADS=1
# REQUIRED if the pod has a GPU: Kokoro auto-loads onto CUDA when visible,
# but TTS_WORKERS is designed for CPU-core parallelism - many workers each
# grabbing their own GPU model copy will exhaust VRAM and crash the run.
# Leave this set (harmless) even on a CPU-only pod.
CUDA_VISIBLE_DEVICES=
ELEVENLABS_API_KEY=

PEXELS_API_KEY=
PIXABAY_API_KEY=

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ffmpeg auto-detects thread count (FFMPEG_THREADS=0) — no change needed,
# it already scales up on its own with however many cores the pod has.
RENDER_ENGINE=ffmpeg
FFMPEG_THREADS=0
