.env
.env.pod
__pycache__/

# local-machine-only, not project source
.claude/
data/
jobs_batch*.json
logs/
*.pyc
.venv/
venv/
node_modules/

# generated per-run artifacts
out/*/*.mp4
out/*/*.mp3
out/*/*.wav
out/*/*.json
!out/*/.gitkeep
logs/*.log

# court-case pipeline outputs (top-level in out/) + auto-sourced media/state
out/*.mp4
out/*.mp3
out/*_work/
assets/court_case/*
!assets/court_case/.gitkeep
config/court_cases/*.resolved.json
config/court_cases/*.qa.json
config/court_cases/_used.json

# downloaded/large assets (kept locally, not versioned)
assets/stock/*
!assets/stock/.gitkeep
assets/music/*
!assets/music/.gitkeep
assets/photos/*/*
!assets/photos/*/.gitkeep

# files staged for Remotion render (raw local paths aren't loadable by Chrome's renderer)
remotion/public/generated/
